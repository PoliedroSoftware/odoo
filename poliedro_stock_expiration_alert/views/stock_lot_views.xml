<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <record id="view_stock_lot_form_poliedro_expiration" model="ir.ui.view"><field name="name">stock.lot.form.poliedro.expiration</field><field name="model">stock.lot</field><field name="inherit_id" ref="stock.view_production_lot_form"/><field name="arch" type="xml">
  <xpath expr="//div[@name='button_box']" position="inside"><button name="action_poliedro_withdraw_stock" type="object" class="oe_stat_button" icon="fa-trash" string="Retirar mercancía" invisible="not product_qty or poliedro_disposition in ('withdrawn', 'loss')"/><button name="action_poliedro_quarantine" type="object" class="oe_stat_button" icon="fa-pause" string="Cuarentena" invisible="poliedro_disposition != 'available'"/><button name="action_poliedro_release" type="object" class="oe_stat_button" icon="fa-check" string="Liberar" invisible="poliedro_disposition != 'quarantine'"/></xpath>
  <xpath expr="//group[@name='inventory_group']" position="inside"><field name="poliedro_expiration_state" widget="badge" decoration-danger="poliedro_expiration_state == 'expired'" decoration-warning="poliedro_expiration_state in ('warning', 'critical')" decoration-success="poliedro_expiration_state == 'ok'"/><field name="poliedro_days_to_expiry"/><field name="poliedro_disposition"/><field name="poliedro_disposition_reason" invisible="poliedro_disposition == 'available'"/><field name="poliedro_disposition_date" invisible="poliedro_disposition == 'available'"/><field name="poliedro_disposition_user_id" invisible="poliedro_disposition == 'available'"/></xpath>
 </field></record>
 <record id="view_poliedro_expiration_alert_list" model="ir.ui.view"><field name="name">stock.lot.poliedro.expiration.list</field><field name="model">stock.lot</field><field name="arch" type="xml"><list create="0" decoration-danger="poliedro_expiration_state == 'expired'" decoration-warning="poliedro_expiration_state in ('critical', 'warning')" decoration-muted="poliedro_disposition in ('withdrawn', 'loss')"><field name="name"/><field name="product_id"/><field name="product_qty"/><field name="location_id"/><field name="expiration_date"/><field name="poliedro_days_to_expiry"/><field name="poliedro_expiration_state" widget="badge" decoration-danger="poliedro_expiration_state == 'expired'" decoration-warning="poliedro_expiration_state in ('critical', 'warning')" decoration-success="poliedro_expiration_state == 'ok'"/><field name="poliedro_disposition" widget="badge"/><field name="company_id" groups="base.group_multi_company"/></list></field></record>
 <record id="action_poliedro_expiration_alert" model="ir.actions.act_window"><field name="name">Alertas de vencimiento</field><field name="res_model">stock.lot</field><field name="view_mode">list,form</field><field name="view_id" ref="view_poliedro_expiration_alert_list"/><field name="domain">[('product_qty', '&gt;', 0), ('expiration_date', '!=', False), ('expiration_date', '&lt;=', (context_today() + datetime.timedelta(days=30)).strftime('%Y-%m-%d 23:59:59'))]</field><field name="context">{'display_complete': True}</field><field name="help" type="html"><p class="o_view_nocontent_smiling_face">No hay lotes próximos a vencer</p><p>Esta vista muestra inventario disponible que vence en los próximos 30 días.</p></field></record>
 <menuitem id="menu_poliedro_expiration_alert" name="Alertas de vencimiento" parent="stock.menu_stock_inventory_control" action="action_poliedro_expiration_alert" sequence="99" groups="stock.group_stock_user"/>
</odoo>
