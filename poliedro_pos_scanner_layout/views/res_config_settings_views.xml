<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form_poliedro_scanner_layout" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.poliedro.scanner.layout</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_interface_section']" position="inside">
                <setting id="poliedro_scanner_layout_default"
                         string="Modo escáner de Poliedro"
                         help="Inicia el punto de venta con el detalle de la compra a pantalla completa y sin mostrar el catálogo de productos.">
                    <field name="pos_poliedro_scanner_layout_default"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
