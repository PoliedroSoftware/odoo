<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="poliedro_pos_scanner_layout.ProductScreen"
       t-inherit="point_of_sale.ProductScreen"
       t-inherit-mode="extension">
        <xpath expr="//div[contains(@class, 'product-screen')]" position="before">
            <div t-if="isPoliedroScannerLayout"
                 class="poliedro-scanner-layout d-flex flex-column h-100 w-100">
                <header class="poliedro-scanner-header d-flex align-items-center justify-content-between gap-3">
                    <div class="d-flex align-items-center gap-3 min-w-0">
                        <div class="poliedro-scanner-heading">
                            <div class="poliedro-scanner-title">Venta por escáner</div>
                            <div class="poliedro-scanner-subtitle">
                                <i class="fa fa-barcode me-1"/> Escanee los productos para agregarlos
                            </div>
                        </div>
                        <div class="poliedro-scanner-status">
                            <span class="poliedro-scanner-status-dot"/> Lector listo
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-3">
                        <div class="poliedro-scanner-customer text-end">
                            <small>Cliente</small>
                            <strong t-esc="currentOrder.getPartner()?.name || 'Consumidor final'"/>
                        </div>
                        <button class="poliedro-layout-toggle is-scanner"
                                t-on-click="togglePoliedroScannerLayout"
                                aria-label="Cambiar a vista clásica">
                            <i class="fa fa-th me-2"/> Vista clásica
                        </button>
                    </div>
                </header>

                <!-- Keep the native OrderSummary mounted as the number-buffer
                     controller. It remains invisible; all business behavior is
                     still handled by Odoo's standard component. -->
                <div class="poliedro-scanner-native-engine" aria-hidden="true">
                    <OrderSummary/>
                </div>

                <main class="poliedro-scanner-main d-flex flex-grow-1 overflow-hidden">
                    <section class="poliedro-scanner-table-card d-flex flex-column flex-grow-1 overflow-hidden">
                        <div class="poliedro-scanner-table-header poliedro-scanner-grid">
                            <span>Cant.</span>
                            <span>Código</span>
                            <span>Detalle</span>
                            <span class="text-end">Vlr. unit.</span>
                            <span class="text-end">IVA</span>
                            <span class="text-center">Desc.</span>
                            <span class="text-end">Subtotal</span>
                        </div>
                        <div t-ref="poliedroScannerTable"
                             class="poliedro-scanner-table-body flex-grow-1 overflow-y-auto">
                            <div t-if="currentOrder.isEmpty()" class="poliedro-scanner-empty">
                                <div class="poliedro-scanner-empty-icon"><i class="fa fa-barcode"/></div>
                                <h3>Escanee el primer producto</h3>
                                <p>El detalle de la venta aparecerá aquí automáticamente.</p>
                            </div>
                            <div t-foreach="currentOrder.lines"
                                 t-as="line"
                                 t-key="line.uuid"
                                 class="poliedro-scanner-row poliedro-scanner-grid"
                                 t-att-class="{
                                     'is-selected': line.isSelected(),
                                     'is-combo-child': line.combo_parent_id,
                                 }"
                                 t-on-click="(event) => this.selectPoliedroScannerLine(event, line)">
                                <div class="poliedro-scanner-qty" t-out="line.getQuantityStr().unitPart + (line.getQuantityStr().decimalPart ? line.getQuantityStr().decimalPoint + line.getQuantityStr().decimalPart : '')"/>
                                <div class="poliedro-scanner-barcode" t-out="line.poliedroScannerBarcode"/>
                                <div class="poliedro-scanner-product">
                                    <strong t-out="line.full_product_name"/>
                                    <small t-if="line.product_id?.default_code and line.product_id.default_code !== line.poliedroScannerBarcode">
                                        Ref. <t t-out="line.product_id.default_code"/>
                                    </small>
                                    <small t-if="line.customer_note" class="poliedro-scanner-note">
                                        <i class="fa fa-sticky-note me-1"/><t t-out="line.customer_note"/>
                                    </small>
                                </div>
                                <div class="poliedro-scanner-money" t-out="line.poliedroScannerUnitPrice"/>
                                <div class="poliedro-scanner-tax text-end">
                                    <strong t-out="line.poliedroScannerTaxRate"/>
                                    <small t-out="line.poliedroScannerTaxAmount"/>
                                </div>
                                <div class="poliedro-scanner-discount text-center"
                                     t-att-class="{'has-discount': line.getDiscount()}">
                                    <span t-out="line.poliedroScannerDiscount"/>
                                    <small t-if="line.getDiscount()" t-out="line.poliedroScannerDiscountAmount"/>
                                </div>
                                <div class="poliedro-scanner-line-total" t-out="line.poliedroScannerLineSubtotal"/>
                            </div>
                        </div>
                    </section>

                    <aside t-if="poliedroScannerState.showNumpad"
                           class="poliedro-scanner-numpad d-flex flex-column">
                        <div class="poliedro-scanner-numpad-title d-flex justify-content-between align-items-center">
                            <span>Editar línea</span>
                            <button class="btn btn-sm btn-light" t-on-click="togglePoliedroScannerNumpad">
                                <i class="fa fa-times"/>
                            </button>
                        </div>
                        <div class="poliedro-scanner-selected-product text-truncate"
                             t-out="poliedroScannerSelectedLine?.full_product_name"/>
                        <Numpad class="'mt-2'" buttons="getNumpadButtons()" onClick.bind="onNumpadClick"/>
                    </aside>
                </main>

                <footer class="poliedro-scanner-footer">
                    <div class="poliedro-scanner-summary d-flex align-items-center justify-content-between gap-4">
                        <div class="poliedro-scanner-counters d-flex align-items-center gap-4">
                            <div><small>Artículos</small><strong t-out="poliedroScannerItems"/></div>
                            <div><small>Líneas</small><strong t-out="poliedroScannerLineCount"/></div>
                            <div><small>Subtotal</small><strong t-out="poliedroScannerSubtotal"/></div>
                            <div><small>Descuentos</small><strong t-out="poliedroScannerDiscounts"/></div>
                            <div><small>IVA</small><strong t-out="poliedroScannerTaxes"/></div>
                        </div>
                        <div class="poliedro-scanner-grand-total">
                            <span>TOTAL</span>
                            <strong t-out="poliedroScannerTotal"/>
                        </div>
                    </div>
                    <div class="poliedro-scanner-actions d-flex align-items-center gap-2">
                        <div class="poliedro-scanner-native-actions d-flex flex-grow-1 gap-2">
                            <ControlButtons onClickMore.bind="displayAllControlPopup"/>
                        </div>
                        <button class="btn btn-secondary btn-lg"
                                t-att-disabled="!poliedroScannerSelectedLine"
                                t-on-click="togglePoliedroScannerNumpad">
                            <i class="fa fa-pencil me-2"/> Editar línea
                        </button>
                        <button class="btn btn-outline-danger btn-lg"
                                t-att-disabled="!poliedroScannerSelectedLine"
                                t-on-click="removePoliedroScannerLine">
                            <i class="fa fa-trash me-2"/> Eliminar
                        </button>
                        <button class="poliedro-scanner-pay btn btn-primary btn-lg"
                                t-att-disabled="currentOrder.isEmpty()"
                                t-on-click="() => this.pos.pay()">
                            <span>Pagar</span>
                            <strong t-out="poliedroScannerTotal"/>
                            <i class="fa fa-arrow-right ms-2"/>
                        </button>
                    </div>
                </footer>
            </div>
        </xpath>

        <xpath expr="//div[contains(@class, 'product-screen')]" position="attributes">
            <attribute name="t-if">!isPoliedroScannerLayout</attribute>
        </xpath>

        <xpath expr="//div[contains(@class, 'product-screen')]" position="inside">
            <button class="poliedro-classic-layout-toggle"
                    t-on-click="togglePoliedroScannerLayout"
                    aria-label="Cambiar a vista escáner">
                <i class="fa fa-barcode me-2"/> Modo escáner
            </button>
        </xpath>
    </t>
</templates>
