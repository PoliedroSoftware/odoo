<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form_poliedro_iot_health" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.poliedro.iot.health</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_interface_section']" position="inside">
                <setting id="poliedro_iot_health_enabled"
                         string="Monitor de equipos IoT"
                         help="Muestra en la vista lector el estado de la impresora, la bascula y el cajon, con acciones de diagnostico y reconexion.">
                    <field name="pos_poliedro_iot_health_enabled"/>
                    <div class="content-group mt16" invisible="not pos_poliedro_iot_health_enabled">
                        <div>
                            <field name="pos_poliedro_iot_health_warn_before_validation"/>
                            <label for="pos_poliedro_iot_health_warn_before_validation"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
