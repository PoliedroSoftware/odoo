<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form_poliedro_einvoice_webhook" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.poliedro.einvoice.webhook</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_interface_section']" position="inside">
                <setting id="poliedro_einvoice_webhook"
                         string="Cola de facturación electrónica"
                         help="Envía las órdenes POS seleccionadas a un webhook intermedio. La cola externa se encarga de comunicarse con la API de facturación electrónica.">
                    <div class="content-group mt16">
                        <div class="row mb-2">
                            <label for="poliedro_einvoice_webhook_url" class="col-lg-3 o_light_label"/>
                            <field name="poliedro_einvoice_webhook_url"
                                   placeholder="https://cola.ejemplo.com/webhooks/pos-invoices"/>
                        </div>
                        <div class="row mb-2">
                            <label for="poliedro_einvoice_webhook_token" class="col-lg-3 o_light_label"/>
                            <field name="poliedro_einvoice_webhook_token" password="True"/>
                        </div>
                        <div class="row mb-2">
                            <label for="poliedro_einvoice_webhook_secret" class="col-lg-3 o_light_label"/>
                            <field name="poliedro_einvoice_webhook_secret" password="True"/>
                        </div>
                        <div class="row">
                            <label for="poliedro_einvoice_webhook_timeout" class="col-lg-3 o_light_label"/>
                            <field name="poliedro_einvoice_webhook_timeout"/>
                            <span class="text-muted ms-2">segundos</span>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
