<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_poliedro_pos_operation_audit_list" model="ir.ui.view">
        <field name="name">poliedro.pos.operation.audit.list</field>
        <field name="model">poliedro.pos.operation.audit</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-danger="action in ('refund', 'order_cancel')" decoration-warning="action in ('price_change', 'discount', 'line_delete')">
                <field name="operation_datetime"/>
                <field name="action"/>
                <field name="config_id"/>
                <field name="order_reference"/>
                <field name="product_id"/>
                <field name="cashier_name"/>
                <field name="supervisor_name"/>
                <field name="reason" optional="show"/>
                <field name="previous_value" optional="hide"/>
                <field name="new_value" optional="hide"/>
                <field name="amount" optional="show"/>
            </list>
        </field>
    </record>
    <record id="view_poliedro_pos_operation_audit_form" model="ir.ui.view">
        <field name="name">poliedro.pos.operation.audit.form</field>
        <field name="model">poliedro.pos.operation.audit</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group><field name="operation_datetime"/><field name="action"/><field name="config_id"/><field name="session_id"/><field name="order_id"/><field name="order_reference"/></group>
                        <group><field name="user_id"/><field name="cashier_name"/><field name="supervisor_id"/><field name="supervisor_name"/><field name="product_id"/><field name="amount"/></group>
                    </group>
                    <group string="Cambio"><field name="previous_value"/><field name="new_value"/><field name="reason"/></group>
                    <group string="Datos técnicos"><field name="payload_json" nolabel="1"/></group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_poliedro_pos_operation_audit_search" model="ir.ui.view">
        <field name="name">poliedro.pos.operation.audit.search</field>
        <field name="model">poliedro.pos.operation.audit</field>
        <field name="arch" type="xml">
            <search>
                <field name="order_reference"/>
                <field name="product_id"/>
                <field name="cashier_name"/>
                <field name="supervisor_name"/>
                <filter string="Hoy" name="today" domain="[('operation_datetime', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter string="Operación" name="group_action" context="{'group_by':'action'}"/>
                    <filter string="Cajero" name="group_user" context="{'group_by':'user_id'}"/>
                    <filter string="Punto de venta" name="group_config" context="{'group_by':'config_id'}"/>
                    <filter string="Día" name="group_day" context="{'group_by':'operation_datetime:day'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_poliedro_pos_operation_audit" model="ir.actions.act_window">
        <field name="name">Auditoría operativa</field><field name="res_model">poliedro.pos.operation.audit</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_poliedro_pos_operation_audit_search"/>
    </record>
    <menuitem id="menu_poliedro_pos_operation_audit" name="Auditoría operativa" parent="point_of_sale.menu_point_rep" action="action_poliedro_pos_operation_audit" sequence="90" groups="point_of_sale.group_pos_manager"/>
</odoo>
