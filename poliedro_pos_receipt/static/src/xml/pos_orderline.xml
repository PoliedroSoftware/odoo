<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="poliedro_pos_receipt.Orderline"
       t-inherit="point_of_sale.Orderline"
       t-inherit-mode="extension">
        <xpath expr="//div[contains(@class, 'line-details')]" position="after">
            <div t-if="vals.isReceipt" class="poliedro-line-values">
                <span class="poliedro-col-qty"><t t-out="vals.unitPart"/></span>
                <span class="poliedro-col-detail"/>
                <span class="poliedro-col-unit" t-out="line.currencyDisplayPriceUnitExcl"/>
                <span class="poliedro-col-tax">
                    <t t-if="line.tax_ids?.length">
                        <t t-foreach="line.tax_ids" t-as="tax" t-key="tax.id">
                            <div><t t-out="tax.amount"/>%</div>
                        </t>
                    </t>
                    <t t-else="">0%</t>
                    <div class="poliedro-tax-amount" t-out="line.poliedroCurrencyDisplayTaxAmount"/>
                </span>
                <span class="poliedro-col-subtotal" t-out="line.poliedroCurrencyDisplaySubtotal"/>
            </div>
        </xpath>
    </t>
</templates>
