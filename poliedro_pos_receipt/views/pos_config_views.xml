<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="pos_config_view_form_poliedro_receipt" model="ir.ui.view">
        <field name="name">pos.config.form.poliedro.receipt</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='proxy_ip']" position="after">
                <field name="poliedro_receipt_title"/>
                <field name="poliedro_receipt_subtitle"/>
                <field name="poliedro_receipt_footer"/>
            </xpath>
        </field>
    </record>
</odoo>
