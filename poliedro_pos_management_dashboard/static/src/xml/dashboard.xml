<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
 <t t-name="poliedro_pos_management_dashboard.Dashboard">
  <div class="o_action poliedro-dashboard">
   <header class="poliedro-dashboard-header"><div><span class="poliedro-dashboard-kicker">Punto de venta</span><h1>Tablero gerencial</h1><p>Ventas, rentabilidad y control operativo en un solo lugar.</p></div><div class="poliedro-dashboard-filters"><button class="btn btn-light" t-on-click="() => setPreset(1)">Hoy</button><button class="btn btn-light" t-on-click="() => setPreset(7)">7 días</button><button class="btn btn-light" t-on-click="() => setPreset(30)">30 días</button><input type="date" class="form-control" t-model="state.dateFrom"/><input type="date" class="form-control" t-model="state.dateTo"/><select class="form-select" t-model="state.configId"><option value="">Todos los POS</option><t t-foreach="state.data?.configs || []" t-as="config" t-key="config.id"><option t-att-value="config.id" t-esc="config.name"/></t></select><button class="btn btn-primary" t-on-click="load">Actualizar</button></div></header>
   <div t-if="state.loading" class="poliedro-dashboard-loading"><i class="fa fa-circle-o-notch fa-spin"/><span>Calculando indicadores…</span></div>
   <t t-elif="state.data">
    <section class="poliedro-kpis"><article><small>Ventas netas</small><strong t-esc="money(state.data.kpis.net_sales)"/><span><t t-esc="state.data.kpis.orders"/> órdenes</span></article><article><small>Margen</small><strong t-esc="money(state.data.kpis.margin)"/><span><t t-esc="state.data.kpis.margin_percent.toFixed(1)"/>%</span></article><article><small>Ticket promedio</small><strong t-esc="money(state.data.kpis.average_ticket)"/><span>Venta bruta <t t-esc="money(state.data.kpis.gross_sales)"/></span></article><article><small>Descuentos</small><strong t-esc="money(state.data.kpis.discounts)"/><span><t t-esc="state.data.audit.discount"/> operaciones auditadas</span></article><article><small>Devoluciones</small><strong t-esc="money(state.data.kpis.refunds)"/><span><t t-esc="state.data.audit.refund"/> autorizadas</span></article><article t-att-class="{'is-alert': Math.abs(state.data.kpis.cash_difference) &gt; 0}"><small>Diferencia de caja</small><strong t-esc="money(state.data.kpis.cash_difference)"/><span>Sesiones cerradas</span></article></section>
    <section class="poliedro-dashboard-grid">
     <article class="poliedro-panel poliedro-panel-wide"><div class="poliedro-panel-title"><div><small>Rendimiento</small><h2>Ventas por hora</h2></div></div><div t-if="!state.data.hours.length" class="poliedro-empty">No hay ventas en el período.</div><div class="poliedro-bars"><div t-foreach="state.data.hours" t-as="row" t-key="row.name" class="poliedro-bar-row"><span t-esc="row.name"/><div><i t-att-style="barWidth(row.sales, state.data.hours)"/></div><strong t-esc="money(row.sales)"/></div></div></article>
     <article class="poliedro-panel"><div class="poliedro-panel-title"><div><small>Equipo</small><h2>Por cajero</h2></div></div><table><thead><tr><th>Cajero</th><th>Órdenes</th><th>Ventas</th></tr></thead><tbody><tr t-foreach="state.data.cashiers" t-as="row" t-key="row.name"><td t-esc="row.name"/><td t-esc="row.orders"/><td t-esc="money(row.sales - row.refunds)"/></tr></tbody></table></article>
     <article class="poliedro-panel"><div class="poliedro-panel-title"><div><small>Catálogo</small><h2>Productos líderes</h2></div></div><table><thead><tr><th>Producto</th><th>Unid.</th><th>Ventas</th></tr></thead><tbody><tr t-foreach="state.data.products" t-as="row" t-key="row.name"><td t-esc="row.name"/><td t-esc="row.qty.toFixed(2)"/><td t-esc="money(row.sales)"/></tr></tbody></table></article>
     <article class="poliedro-panel"><div class="poliedro-panel-title"><div><small>Inventario</small><h2>Baja rotación</h2></div></div><div t-if="!state.data.low_rotation.length" class="poliedro-empty">Sin productos inmovilizados.</div><table t-else=""><thead><tr><th>Producto</th><th>Stock</th><th>Vendido</th></tr></thead><tbody><tr t-foreach="state.data.low_rotation" t-as="row" t-key="row.name"><td t-esc="row.name"/><td t-esc="row.stock.toFixed(2)"/><td t-esc="row.sold.toFixed(2)"/></tr></tbody></table></article>
     <article class="poliedro-panel"><div class="poliedro-panel-title"><div><small>Control interno</small><h2>Operaciones sensibles</h2></div><strong class="poliedro-audit-total" t-esc="state.data.audit_total"/></div><div class="poliedro-audit-grid"><div><span>Eliminaciones</span><b t-esc="state.data.audit.line_delete"/></div><div><span>Cambios de precio</span><b t-esc="state.data.audit.price_change"/></div><div><span>Descuentos</span><b t-esc="state.data.audit.discount"/></div><div><span>Devoluciones</span><b t-esc="state.data.audit.refund"/></div><div><span>Anulaciones</span><b t-esc="state.data.audit.order_cancel"/></div><div><span>Aperturas de cajón</span><b t-esc="state.data.audit.cashbox_open"/></div></div></article>
    </section>
   </t>
  </div>
 </t>
</templates>
